{
  "version": "0.2",
  "language": "en,en-GB",
  "ignorePaths": [
    "docs/api/**",
    "node_modules/**",
    "build/**",
    ".docusaurus/**",
    "static/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "babylon-project-words",
      "path": ".cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["babylon-project-words"],
  "patterns": [
    { "name": "MdFencedCode", "pattern": "/^ {0,3}(```|~~~)[\\s\\S]*?^ {0,3}\\1/gm" },
    { "name": "MdInlineCode", "pattern": "/`[^`\\n]+`/g" },
    { "name": "MdxImportExport", "pattern": "/^(import|export) .*$/gm" },
    { "name": "MdxJsxTag", "pattern": "/<[A-Za-z][^>]*>/g" },
    { "name": "Bech32Addr", "pattern": "/\\b(bbn|bc1|tb1|bcrt1)[02-9ac-hj-np-z]{8,}\\b/g" },
    { "name": "HexAddr", "pattern": "/\\b0x[0-9a-fA-F]{6,}\\b/g" }
  ],
  "ignoreRegExpList": [
    "MdFencedCode",
    "MdInlineCode",
    "MdxImportExport",
    "MdxJsxTag",
    "Bech32Addr",
    "HexAddr",
    "Urls",
    "Email"
  ]
}
